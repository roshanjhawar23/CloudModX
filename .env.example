# ==========================================
# CloudModX Root Environment Configuration
# ==========================================

# Application
ENVIRONMENT=development
PROJECT_NAME=CloudModX
VERSION=0.1.0
SECRET_KEY=generate-a-secure-secret-key-32-chars-minimum

# Database (PostgreSQL)
# Host Port Mapping: 5433 (maps to container port 5432) to avoid local host port 5432 conflict
POSTGRES_USER=cloudmodx_user
POSTGRES_PASSWORD=cloudmodx_password
POSTGRES_DB=cloudmodx_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg2://cloudmodx_user:cloudmodx_password@127.0.0.1:5433/cloudmodx_db

# Frontend
VITE_API_URL=http://localhost:8000
