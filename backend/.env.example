# CloudModX Backend Environment Variables
ENVIRONMENT=development
PROJECT_NAME=CloudModX
VERSION=0.1.0
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# PostgreSQL Database Configuration
# Host Development (connecting from Windows host to Docker PostgreSQL mapped to 5433):
DATABASE_URL=postgresql+psycopg2://cloudmodx_user:cloudmodx_password@127.0.0.1:5433/cloudmodx_db
POSTGRES_USER=cloudmodx_user
POSTGRES_PASSWORD=cloudmodx_password
POSTGRES_DB=cloudmodx_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Note for Docker Stack:
# Inside Docker containers, the backend connects directly to @db:5432 via Docker network:
# DATABASE_URL=postgresql+psycopg2://cloudmodx_user:cloudmodx_password@db:5432/cloudmodx_db
