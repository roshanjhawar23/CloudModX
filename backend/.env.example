# CloudModX Backend Environment Variables
# Used when running the backend directly on your machine (from inside backend/).
# Copy to backend/.env:  cp .env.example .env
ENVIRONMENT=development
PROJECT_NAME=CloudModX
VERSION=0.1.0
# Fine as-is for local development. For production, generate a real key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-generate-with-python-secrets-token-hex-32

# PostgreSQL Database Configuration
# Host Development (connecting from host machine to Docker PostgreSQL mapped to port 5433):
DATABASE_URL=postgresql+psycopg2://cloudmodx_user:cloudmodx_password@127.0.0.1:5433/cloudmodx_db
POSTGRES_USER=cloudmodx_user
POSTGRES_PASSWORD=cloudmodx_password
POSTGRES_DB=cloudmodx_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Note for Docker Compose Stack:
# When running within Docker Compose, the backend container connects directly to @db:5432:
# DATABASE_URL=postgresql+psycopg2://cloudmodx_user:cloudmodx_password@db:5432/cloudmodx_db

# Artifact storage
# Leave ARTIFACT_BUCKET_NAME empty to store uploaded artifacts on local disk.
# To use Amazon S3, set it to YOUR bucket (Terraform output: artifact_bucket_name).
ARTIFACT_BUCKET_NAME=
AWS_REGION=ap-south-1

# Set to true to print every SQL statement in the backend logs (very noisy)
SQL_ECHO=false
